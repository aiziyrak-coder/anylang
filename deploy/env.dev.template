# AnyLang — DEV (same VPS as prod, isolated DB/volumes/ports)
# Copy to deploy/.env.dev on the server (never commit).
#
# Bootstrap: python scripts/bootstrap_dev_stack.py
# Or manually clone deploy/.env → .env.dev and replace values below.

APP_NAME=AnyLang
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

SECRET_KEY=REPLACE_WITH_openssl_rand_base64_48
ADMIN_SECRET_KEY=REPLACE_WITH_openssl_rand_base64_48_DIFFERENT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

POSTGRES_PASSWORD=REPLACE_STRONG_DEV_PG_PASSWORD
REDIS_PASSWORD=REPLACE_STRONG_DEV_REDIS_PASSWORD

DATABASE_URL=postgresql+asyncpg://anylang:REPLACE_STRONG_DEV_PG_PASSWORD@postgres:5432/anylang_dev
REDIS_URL=redis://:REPLACE_STRONG_DEV_REDIS_PASSWORD@redis:6379/0

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=anylang_dev
S3_SECRET_KEY=REPLACE_STRONG_S3_SECRET
S3_BUCKET=anylang-dev
S3_REGION=auto
S3_PUBLIC_BASE_URL=https://dev.anylang.uz/media

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AnyLang Dev <noreply@dev.anylang.uz>
SMTP_TLS=true
RESEND_API_KEY=
SMTP_FAIL_OPEN=true
ALLOW_OTP_IN_RESPONSE=true

GOOGLE_CLIENT_IDS=
TRANSLATION_PROVIDER=openai
ALLOW_MOCK_TRANSLATION=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Dev: mock payments OK (Click optional)
PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=true
PUBLIC_API_BASE_URL=https://dev.anylang.uz
USD_UZS_RATE=12500
PAYMENT_PENDING_POLICY=cancel_and_recreate

ADMIN_EMAIL=admin@dev.anylang.uz
ADMIN_PASSWORD=REPLACE_STRONG_ADMIN_PASSWORD
ADMIN_SEED_IN_PRODUCTION=true

CORS_ORIGINS=https://dev.anylang.uz
TRUSTED_HOSTS=dev.anylang.uz,127.0.0.1,localhost

SENTRY_DSN=
LOG_LEVEL=DEBUG
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
