# AnyLang production — copy to deploy/.env and fill secrets before first deploy.
# NEVER commit deploy/.env. Generate secrets: openssl rand -base64 48
APP_NAME=AnyLang
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

SECRET_KEY=REPLACE_WITH_openssl_rand_base64_48
ADMIN_SECRET_KEY=REPLACE_WITH_openssl_rand_base64_48_DIFFERENT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=60

POSTGRES_PASSWORD=REPLACE_STRONG_PG_PASSWORD
REDIS_PASSWORD=REPLACE_STRONG_REDIS_PASSWORD

DATABASE_URL=postgresql+asyncpg://anylang:REPLACE_STRONG_PG_PASSWORD@postgres:5432/anylang
# Must embed the same password as REDIS_PASSWORD (dotenv does not expand ${REDIS_PASSWORD}).
REDIS_URL=redis://:REPLACE_STRONG_REDIS_PASSWORD@redis:6379/0

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=anylang_prod
S3_SECRET_KEY=REPLACE_STRONG_S3_SECRET
S3_BUCKET=anylang
S3_REGION=auto
S3_PUBLIC_BASE_URL=https://anylang.uz/media

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AnyLang <noreply@anylang.uz>
SMTP_TLS=true
# Preferred: Resend API (https://resend.com) — verify domain DNS then set key
RESEND_API_KEY=
SMTP_FAIL_OPEN=false
ALLOW_OTP_IN_RESPONSE=false

GOOGLE_CLIENT_IDS=
TRANSLATION_PROVIDER=openai
ALLOW_MOCK_TRANSLATION=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPL_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Production: click (UZ) + paddle (intl). Mock payments must stay false.
PAYMENT_PROVIDER=click
ALLOW_MOCK_PAYMENTS=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://anylang.uz/billing/success
STRIPE_CANCEL_URL=https://anylang.uz/billing/cancel
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=108598
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
CLICK_PAY_BASE_URL=https://my.click.uz/services/pay
CLICK_MERCHANT_API_BASE=https://api.click.uz/v2/merchant
CLICK_OFD_SPIC=10305008003000000
CLICK_OFD_PACKAGE_CODE=1545646
CLICK_OFD_UNITS=1
CLICK_OFD_ITEM_NAME=AnyLang
CLICK_OFD_INN=310682057
CLICK_OFD_VAT_PERCENT=0
PAYMENT_TEST_AMOUNT_UZS=1000
PUBLIC_API_BASE_URL=https://anylang.uz
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_VENDOR_ID=
PADDLE_API_BASE_URL=https://api.paddle.com
PADDLE_PRICE_PREMIUM_MONTHLY=
PADDLE_PRICE_PREMIUM_YEARLY=
PADDLE_PRICE_BUSINESS_MONTHLY=
PADDLE_PRICE_BUSINESS_YEARLY=
USD_UZS_RATE=12500
PAYMENT_PENDING_POLICY=cancel_and_recreate

ADMIN_EMAIL=admin@anylang.com
ADMIN_PASSWORD=REPLACE_STRONG_ADMIN_PASSWORD
ADMIN_SEED_IN_PRODUCTION=false

CORS_ORIGINS=https://anylang.uz,https://www.anylang.uz
TRUSTED_HOSTS=anylang.uz,www.anylang.uz,127.0.0.1,localhost

# Optional: https://sentry.io — leave empty to disable
SENTRY_DSN=

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
LOG_LEVEL=INFO
