# AnyLang — staging (production-like, separate DB/secrets)
# Copy to deploy/.env.staging on the staging host.

APP_NAME=AnyLang
APP_ENV=staging
DEBUG=false
API_V1_PREFIX=/api/v1

SECRET_KEY=REPLACE_WITH_openssl_rand_base64_48
ADMIN_SECRET_KEY=REPLACE_WITH_openssl_rand_base64_48_DIFFERENT
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=60

POSTGRES_PASSWORD=REPLACE_STRONG_STAGING_PG_PASSWORD

# DB name must match POSTGRES_DB in docker-compose.prod.yml (anylang)
DATABASE_URL=postgresql+asyncpg://anylang:REPLACE_STRONG_STAGING_PG_PASSWORD@postgres:5432/anylang
REDIS_PASSWORD=REPLACE_STRONG_REDIS_PASSWORD
# Embed the same password literally (dotenv does not expand ${VAR}).
REDIS_URL=redis://:REPLACE_STRONG_REDIS_PASSWORD@redis:6379/0

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=anylang_staging
S3_SECRET_KEY=REPLACE_STRONG_S3_SECRET
S3_BUCKET=anylang-staging
S3_REGION=auto
S3_PUBLIC_BASE_URL=https://staging.anylang.uz/media

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AnyLang Staging <noreply@staging.anylang.uz>
SMTP_TLS=true
SMTP_FAIL_OPEN=false
ALLOW_OTP_IN_RESPONSE=false

GOOGLE_CLIENT_IDS=
TRANSLATION_PROVIDER=openai
ALLOW_MOCK_TRANSLATION=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
MULTICARD_BASE_URL=
MULTICARD_APPLICATION_ID=
MULTICARD_SECRET=
MULTICARD_STORE_ID=
PUBLIC_API_BASE_URL=https://staging.anylang.uz
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_VENDOR_ID=
PADDLE_API_BASE_URL=https://sandbox-api.paddle.com
PADDLE_PRICE_PREMIUM_MONTHLY=
PADDLE_PRICE_PREMIUM_YEARLY=
PADDLE_PRICE_BUSINESS_MONTHLY=
PADDLE_PRICE_BUSINESS_YEARLY=
USD_UZS_RATE=12500
PAYMENT_PENDING_POLICY=cancel_and_recreate

ADMIN_EMAIL=admin@staging.anylang.uz
ADMIN_PASSWORD=REPLACE_STRONG_ADMIN_PASSWORD
ADMIN_SEED_IN_PRODUCTION=false

CORS_ORIGINS=https://staging.anylang.uz
TRUSTED_HOSTS=staging.anylang.uz,127.0.0.1,localhost

SENTRY_DSN=
