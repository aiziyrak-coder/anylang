# Flutter run targets (debug)
#
# Android emulator (host API):
# Default in code is https://anylang.uz (production).
# Local emulator override:
#   flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000
#
# Physical device (replace with your PC LAN IP):
#   flutter run --dart-define=API_BASE_URL=http://192.168.1.100:8000
#
# Production:
#   flutter build apk --dart-define=API_BASE_URL=https://anylang.uz/ \
#     --dart-define=GOOGLE_SERVER_CLIENT_ID=xxx.apps.googleusercontent.com \
#     --dart-define=GOOGLE_MAPS_API_KEY=your-maps-api-key
#
# Google Sign-In (majburiy — Web + Android OAuth client):
#   1) https://console.cloud.google.com/apis/credentials
#   2) Create OAuth client — Application type: Web → copy Client ID
#      (shu ID ni GOOGLE_SERVER_CLIENT_ID va server GOOGLE_CLIENT_IDS ga qo'ying)
#   3) Create OAuth client — Android:
#        package: com.cradev.anylang
#        SHA-1 (release): B4:04:E7:C6:BF:B8:A7:B9:9B:17:88:D2:32:F5:9A:08:4E:B8:E7:C4
#        SHA-1 (debug):   61:76:74:F3:81:26:4A:27:C2:FB:65:06:DB:A6:4D:9B:6B:AD:80:1A
#   4) deploy/.env: GOOGLE_CLIENT_IDS=<web-client-id>
#   5) Shu fayl yoki env: GOOGLE_SERVER_CLIENT_ID=<web-client-id>
#
# Google Maps (joylashuv sheet):
#   1) https://console.cloud.google.com/google/maps-apis/credentials
#   2) Enable: Maps SDK for Android, Maps SDK for iOS, Places API, Geocoding API
#   3) Put key in android/local.properties:
#        GOOGLE_MAPS_API_KEY=AIza...
#      and/or pass --dart-define=GOOGLE_MAPS_API_KEY=AIza...

API_BASE_URL=http://10.0.2.2:8000
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_MAPS_API_KEY=
