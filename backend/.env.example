# AnyLang — local development
# Copy to backend/.env (never commit real secrets)

APP_NAME=AnyLang
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

SECRET_KEY=local-dev-secret-key-change-me-32chars-min!!
ADMIN_SECRET_KEY=local-admin-secret-key-change-me-32chars!!
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=60

DATABASE_URL=postgresql+asyncpg://anylang:anylang@localhost:5432/anylang
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=anylang
S3_SECRET_KEY=anylangsecret
S3_BUCKET=anylang
S3_REGION=auto
S3_PUBLIC_BASE_URL=http://localhost:9000/anylang

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AnyLang <noreply@anylang.local>
SMTP_TLS=false
# Preferred in production: https://resend.com (verify domain anylang.uz)
RESEND_API_KEY=
SMTP_FAIL_OPEN=true
ALLOW_OTP_IN_RESPONSE=true

GOOGLE_CLIENT_IDS=
TRANSLATION_PROVIDER=mock
ALLOW_MOCK_TRANSLATION=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSLATION_MODEL=gpt-4o
DEEPL_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

PAYMENT_PROVIDER=mock
ALLOW_MOCK_PAYMENTS=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Click (UZS, local cards) — leave empty until merchant credentials are issued
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
CLICK_PAY_BASE_URL=https://my.click.uz/services/pay
CLICK_MERCHANT_API_BASE=https://api.click.uz/v2/merchant
CLICK_OFD_SPIC=
CLICK_OFD_PACKAGE_CODE=
CLICK_OFD_UNITS=1
CLICK_OFD_ITEM_NAME=AnyLang
CLICK_OFD_INN=
CLICK_OFD_VAT_PERCENT=0
# Temporary flat charge while Click is being activated (empty = real catalog prices)
PAYMENT_TEST_AMOUNT_UZS=1000
PUBLIC_API_BASE_URL=http://localhost:8000

# Paddle MoR (USD, international Visa/Mastercard) — sandbox: https://sandbox-api.paddle.com
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_VENDOR_ID=
PADDLE_API_BASE_URL=https://sandbox-api.paddle.com
PADDLE_PRICE_PREMIUM_MONTHLY=
PADDLE_PRICE_PREMIUM_YEARLY=
PADDLE_PRICE_BUSINESS_MONTHLY=
PADDLE_PRICE_BUSINESS_YEARLY=

# USD→UZS for Click amounts (manual / Central Bank update)
USD_UZS_RATE=12500
# cancel_and_recreate | return_existing | reject
PAYMENT_PENDING_POLICY=cancel_and_recreate

ADMIN_EMAIL=admin@anylang.local
ADMIN_PASSWORD=admin-local-change-me
ADMIN_SEED_IN_PRODUCTION=false

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=
SENTRY_DSN=
